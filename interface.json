{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaDori",
    "description": "MaaDori 是一个基于 MaaFramework 的自动化项目。",
    "contact": "QQ: 820924380",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MaaDori!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/BlueRainLi/MaaDori",
    "version": "1.0.0",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaDori",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720, // 默认缩放分辨率的短边长度
            // 目标 App：BanG Dream! 少女乐团派对（B 站国服）
            // 包名 com.bilibili.star.bili，启动 / 停止 App 由 Client 侧调用（PI v2 协议本身无包名字段）
            "adb": {
                // 本机 adb 未加入 PATH（ANDROID_HOME 也未设置），这里直接指向 scrcpy 自带的 adb
                "adb_path": "D:/Tools/scrcpy-win64-v4.0/adb.exe",
                // LDPlayer 9 首个实例；adb devices 中显示为 emulator-5554
                "address": "127.0.0.1:5555"
            }
        }
    ],
    "resource": [
        {
            "name": "B 服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "./agent/main.py"
    //     ]
    // },
    "task": [
        {
            "name": "启动游戏",
            "entry": "启动游戏"
        },
        {
            "name": "普通任务",
            "entry": "MyTask1"
        },
        {
            "name": "选项任务",
            "entry": "MyTask2",
            "option": [
                "任务选项1"
            ]
        },
        {
            "name": "参数任务",
            "entry": "MyTask3",
            "option": [
                "任务选项1"
            ],
            "pipeline_override": {}
        },
        {
            "name": "自定义识别与动作示例",
            "entry": "FindSmallestNumber"
        }
    ],
    "option": {
        "任务选项1": {
            "type": "select",
            "cases": [
                {
                    "name": "文本1",
                    "pipeline_override": {
                        "OcrTask": {
                            "text": "文本1"
                        }
                    }
                },
                {
                    "name": "文本2",
                    "pipeline_override": {
                        "OcrTask": {
                            "text": "文本2"
                        }
                    }
                }
            ]
        }
    }
}
