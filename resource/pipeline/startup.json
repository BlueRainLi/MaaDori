{
    // 开 App 后的启动流程：拉起 App → 闪屏连点加速 → 等标题画面 → 点屏幕中间进入游戏
    //
    // 【启动游戏】package 必须写成 "包名/Activity" 的组件形式。依据 MaaFramework
    // source/MaaAdbControlUnit/General/Activity.cpp 的 start_app：
    //   intent 里不含 "/" → adb shell monkey -p {INTENT} 1
    //   intent 里含  "/" → adb shell am start -n {INTENT}
    // 本机 LDPlayer 镜像里没有 monkey（实测 `/system/bin/sh: monkey: inaccessible
    // or not found`），所以只能走 am start 分支。
    // 另外 com.bilibili.star.bili.MainActivity 未导出，用它会 SecurityException，
    // 启动入口要填 PermissionActivity（实测可用，拉起后自动跳 MainActivity）。
    "启动游戏": {
        "action": "StartApp",
        "package": "com.bilibili.star.bili/com.bilibili.star.bili.PermissionActivity",
        "post_delay": 1500, // 等闪屏画面起来，别对着黑屏点
        "next": [
            "闪屏加速"
        ]
    },

    // 【闪屏加速】闪屏阶段点画面可以跳过开场动画，标题画面能提前约 10s 出现。
    // 实测（冷启动，force-stop 后重开，逐秒截图统计标题按钮首次命中 >= 0.8 的时刻）：
    //   不点      → 19.4s       点 5 下（1.5~5.5s）     → 16.6s
    //   点 5 下（1.5~9.8s） → 11.1s   点 8 下（1~8.7s）  → 9.6s
    //   点 9 下（1.5~8.9s） → 9.9s    点 12 下（1~10.6s）→ 10.9s
    // 结论：约 9~10 下、间隔约 1s、覆盖到第 9 秒左右最好；再多也没有额外收益，
    // 因为剩下的时间是在等游戏自己的加载。
    //
    // 用 DirectHit 无条件命中，靠 repeat 做「一次识别决定、连点 N 下」，
    // 不引入额外的模板图。点的是屏幕正中，闪屏和标题画面都吃这个点击位置。
    // 万一点到了刚出现的标题画面也不会出错：点了之后标题还要停留约 10s 才是加载条，
    // 下一节点仍能识别到标题按钮，只是多点一下（多点无效）。
    "闪屏加速": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            640,
            360
        ],
        "repeat": 9,
        "repeat_delay": 900,
        "next": [
            "进入游戏"
        ]
    },

    // 【进入游戏】标题画面右下角有个「四宫格图标 + 菜单」的浅色圆角按钮，
    // 用它作为「标题画面已就绪」的判定锚点；识别到就点屏幕中间（触发 TAP TO START）。
    //
    // 模板从 1280x720 原生截图裁剪而来（(1190,627) 处 64x73），与 720p 基线 1:1，无需缩放。
    // roi 限制在右下角，避免和左下角那个「logo + 菜单」按钮混淆
    // （实测左下角得分 0.43，真按钮 1.0，阈值 0.8 余量充足）。
    // timeout 给 120s 兜底：正常点完是 10s 内出标题，留足余量给冷启动慢的时候。
    "进入游戏": {
        "recognition": "TemplateMatch",
        "template": "title_menu_button.png",
        "roi": [
            1140,
            600,
            140,
            120
        ],
        "threshold": 0.8,
        "action": "Click",
        "target": [
            640,
            360
        ], // 屏幕正中，点一下推进 TAP TO START
        "post_delay": 1500,
        "timeout": 120000,
        "rate_limit": 1000
    }
}
