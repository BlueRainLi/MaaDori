{
    // ── 通用弹窗 / 教程拦截 ──────────────────────────────────────────────
    //
    // 用法（MaaFramework 的 [JumpBack] 机制，协议文档 3.1 的「中断机制」章节）：
    // 需要防弹窗的业务节点，把本节点追加到自己的 next 列表**末尾**：
    //
    //   "某业务节点": {
    //       "next": ["真正的目标节点", "[JumpBack]教程弹窗"]
    //   }
    //
    // 执行逻辑：父节点每轮按顺序识别 next —— 目标没出现就先命中本节点，
    // 点一下「下一步」，节点链执行完毕后自动**跳回父节点**重新识别。
    // 教程有多页也没问题：每点一次跳回一次，直到弹窗消失、真正的目标能识别到为止。
    // 因为排在末尾，业务目标的优先级永远高于弹窗处理，不会抢正常的识别。
    //
    // 为什么要单独一个节点、而不是在业务节点里加判断：
    //   - 弹窗在任意时刻、任意业务里都可能出现，[JumpBack] 是唯一不打断主流程的机制
    //   - 教程按钮的文字会从「下一步」变成「关闭」（点了若干页之后），所以用 OCR
    //     按文字匹配，一个节点同时覆盖两种状态，不用为每个文案维护一张模板图
    //
    // ⚠️ 依赖 OCR 模型：resource/model/ocr/ 下必须有 det.onnx / rec.onnx / keys.txt。
    // 本地没有就 `git submodule update --init --recursive` 后跑 `python tools/configure.py`。
    // 模型 30MB 不进仓库（resource/model/.gitignore 已忽略 ocr）。
    "教程弹窗": {
        "recognition": "OCR",
        // 实测这一版的按钮在 (861,611)-(1101,675)，1280x720 基线。
        // roi 放宽到右下区域：既能覆盖实际位置，又避免全屏 OCR 拖慢轮询、
        // 也避免误吃界面上其他位置的「关闭」文字。
        "roi": [
            400,
            540,
            880,
            180
        ],
        // 教程翻到最后一页时按钮文案变成「关闭」，两个都接
        "expected": [
            "下一步",
            "关闭"
        ],
        "threshold": 0.5, // PP-OCR 对清晰印刷体的置信度通常 >0.9，0.5 足够滤噪
        "action": "Click",
        "target": true, // 点 OCR 识别到的文字框中心，即按钮本身
        "post_delay": 700, // 等翻页动画，避免连点打到上一页的位置
        "rate_limit": 500
    }
}
